# SIP Backend Environment Configuration
# Copy to .env and fill in real values for local development.
# NEVER commit .env or any file containing real secrets.

# -- Database ------------------------------------------------
# Neon PostgreSQL connection string (find in Neon dashboard ? Connection Details ? Connection string)
DATABASE_URL=

# Override individual fields if needed (optional; DATABASE_URL takes precedence)
DATABASE_USERNAME=
DATABASE_PASSWORD=

# -- JWT -----------------------------------------------------
# Secret key for signing JWT tokens. Must be at least 256 bits (32+ characters).
# Generate with: openssl rand -base64 64
JWT_SECRET=

# Token expiry (seconds). Defaults: 900 (15 min) for access, 604800 (7 days) for refresh.
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# -- Server --------------------------------------------------
SERVER_PORT=8080