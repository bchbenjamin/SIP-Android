# SIP Backend Environment Configuration
# Copy to .env for local development. Never commit .env or real credentials.
# The backend consumes a JDBC URL, not a Neon management API key.
# Use the JDBC URL from your Neon connection details and ensure sslmode=require.
# URL-encode reserved characters in username/password query values.
DATABASE_URL='jdbc:postgresql://YOUR_NEON_HOST/YOUR_DATABASE?user=YOUR_USERNAME&password=YOUR_URL_ENCODED_PASSWORD&sslmode=require'

# Required in any non-test environment. Generate with: openssl rand -base64 48
JWT_SECRET=

# Optional first-admin bootstrap. Both must be set, and password must be 12+ chars.
# Remove these variables after the first administrator is created.
SIP_BOOTSTRAP_ADMIN_USERNAME=
SIP_BOOTSTRAP_ADMIN_PASSWORD=

JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800
SERVER_PORT=8080
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=0
